{
  "name": "travel-ops-pro",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL && next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "node scripts/sync-plans.mjs && next start",
    "cron:agent-memory": "node scripts/cron-agent-memory.mjs",
    "cron:exchange-rates": "node scripts/cron-exchange-rates.mjs",
    "cron:reminders": "node scripts/cron-reminders.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "lint:ratchet": "node scripts/check-lint-ratchet.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "stripe:plans": "node scripts/setup-stripe-plans.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "analyze": "ANALYZE=true npm run build",
    "plans:check": "node scripts/sync-plans.mjs --check",
    "plans:generate": "vitest run lib/__tests__/plans-sync.test.ts -u",
    "types:generate": "node scripts/generate-db-types.mjs",
    "types:check": "node scripts/generate-db-types.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@react-pdf/renderer": "^4.3.2",
    "@stripe/stripe-js": "^8.6.4",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.74.0",
    "@tiptap/extension-color": "^3.11.1",
    "@tiptap/extension-font-family": "^3.11.1",
    "@tiptap/extension-highlight": "^3.11.1",
    "@tiptap/extension-link": "^3.11.1",
    "@tiptap/extension-placeholder": "^3.11.1",
    "@tiptap/extension-text-align": "^3.11.1",
    "@tiptap/extension-text-style": "^3.11.1",
    "@tiptap/extension-underline": "^3.11.1",
    "@tiptap/react": "^3.11.1",
    "@tiptap/starter-kit": "^3.11.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "googleapis": "^166.0.0",
    "isomorphic-dompurify": "^3.18.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "next": "^16.0.10",
    "openai": "^6.8.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.33.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.4.1",
    "resend": "^6.4.2",
    "stripe": "^20.2.0",
    "twilio": "^5.10.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.2.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.6",
    "railway": "^3.11.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
