# ============================================================
# Autoura — environment template (self-hosted install, plan §5)
# ============================================================
# Copy to .env.local for local dev, or set these as environment variables on
# your host (Railway, Docker, etc.). Sections marked OPTIONAL can be left
# unset — the related feature disables itself cleanly.

# ------------------------------------------------------------
# REQUIRED — Supabase (your project: Dashboard → Settings → API)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Dashboard → Settings → Database).
# Used ONLY by scripts/migrate.mjs — the app itself talks to Supabase above.
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------
# REQUIRED — app identity
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Comma-separated emails allowed into the super-admin console
SUPER_ADMIN_EMAILS=

# ------------------------------------------------------------
# REQUIRED for AI features — Anthropic
# ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# OPTIONAL — email sending (Resend). Without it, outbound email features
# report "not configured" instead of sending.
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OPTIONAL — Gmail inbox integration (OAuth app credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32+ random bytes; signs the OAuth state parameter
OAUTH_STATE_SECRET=

# ------------------------------------------------------------
# OPTIONAL — WhatsApp. Set WHATSAPP_PROVIDER to 'twilio' or 'meta' and fill
# the matching block. Unset = WhatsApp features disabled.
# ------------------------------------------------------------
WHATSAPP_PROVIDER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Meta Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------
# OPTIONAL — billing (Stripe). Self-hosted installs under a support contract
# typically leave this unset; tenants are managed in the super-admin console.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# OPTIONAL — everything else
# ------------------------------------------------------------
# Live FX refresh (exchangerate-api.com); without it, seeded rates stay fixed
EXCHANGE_RATE_API_KEY=
# Web push for the ops PWA (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.example
# Shared secret protecting /api/cron/* endpoints
CRON_SECRET=
# Inbound concierge-brief webhook (unset = endpoint rejects)
CONCIERGE_WEBHOOK_SECRET=
