# ============================================================
# Autoura SaaS — environment template
# ============================================================
# Copy to .env.local for local dev, or set these as environment variables on
# your host (Railway, Docker, etc.). Sections marked OPTIONAL can be left
# unset — the related feature disables itself cleanly.

# ------------------------------------------------------------
# REQUIRED — Supabase (your project: Dashboard → Settings → API)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Dashboard → Settings → Database).
# Used ONLY by scripts/migrate.mjs — the app itself talks to Supabase above.
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------
# REQUIRED — app identity
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Comma-separated emails allowed into the super-admin console
SUPER_ADMIN_EMAILS=

# ------------------------------------------------------------
# REQUIRED for AI features — Anthropic
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPTIONAL — OpenAI: message translation (/api/translate) and the copilot's
# knowledge-base embeddings. Unset = those two features are off.
OPENAI_API_KEY=
# OPTIONAL — WhatsApp AI auto-replies. Off unless 'true'; each company also
# switches it on for itself in Settings. TOOLS lets the agent look up bookings.
WHATSAPP_AI_ENABLED=
WHATSAPP_AI_TOOLS_ENABLED=
# Model for WhatsApp replies (default: the app's main Claude model)
WHATSAPP_AI_MODEL=
# The legacy "parse a WhatsApp itinerary" tool; off unless 'true'
PARSE_WHATSAPP_ENABLED=

# ------------------------------------------------------------
# OPTIONAL — email sending (Resend). Without it, outbound email features
# report "not configured" instead of sending.
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signing secret of the Resend webhook (Resend → Webhooks → endpoint
# <APP_URL>/api/webhooks/resend, events email.bounced + email.complained).
# Without it bounces are not recorded and the webhook refuses every call.
RESEND_WEBHOOK_SECRET=

# OPTIONAL — Gmail inbox integration (OAuth app credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32+ random bytes; signs the OAuth state parameter
OAUTH_STATE_SECRET=
# Encrypts stored Gmail tokens at rest (any long random string, e.g.
# `openssl rand -base64 32`). Set it once and keep it: existing plain-text
# tokens keep working and are sealed on their next refresh; losing the key
# means every mailbox must reconnect.
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------
# OPTIONAL — WhatsApp. Set WHATSAPP_PROVIDER to 'twilio' or 'meta' and fill
# the matching block. Unset = WhatsApp features disabled.
# ------------------------------------------------------------
WHATSAPP_PROVIDER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Older name for the same sender; TWILIO_WHATSAPP_FROM wins when both are set
TWILIO_WHATSAPP_NUMBER=
# Optional API-key auth instead of the account auth token
TWILIO_API_KEY=
TWILIO_API_SECRET=
# SMS template sends: the number to send from (TWILIO_SMS_FROM wins)
TWILIO_SMS_FROM=
TWILIO_PHONE_NUMBER=
# Platform defaults shown on the WhatsApp status page
BUSINESS_NAME=
BUSINESS_WHATSAPP=
ENABLE_WHATSAPP_AUTO_SEND=
ENABLE_WHATSAPP_STATUS_UPDATES=
# Meta Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version (default v21.0)
META_GRAPH_API_VERSION=

# ------------------------------------------------------------
# OPTIONAL — billing (Stripe). Leave unset to manage tenants by hand in the
# super-admin console; set it to charge subscriptions.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# OPTIONAL — everything else
# ------------------------------------------------------------
# Live FX refresh (exchangerate-api.com); without it, seeded rates stay fixed
EXCHANGE_RATE_API_KEY=
# Web push for the ops PWA (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.example
# Shared secret protecting /api/cron/* endpoints
CRON_SECRET=
# Inbound concierge-brief webhook (unset = endpoint rejects). Set _PREVIOUS
# to the old value while rotating, so senders on either key still work.
CONCIERGE_WEBHOOK_SECRET=
CONCIERGE_WEBHOOK_SECRET_PREVIOUS=
# Sawa departure/capacity sync (unset = those endpoints reject); _PREVIOUS
# as above, for rotation.
SAWA_SYNC_SECRET=
SAWA_SYNC_SECRET_PREVIOUS=
# Signs the customer-portal "verified" cookie. Falls back to the service-role
# key; set its own random value so rotating one does not log out the other.
PORTAL_VERIFY_SECRET=
# Where the marketing contact form and support chat deliver
# (CONTACT_INBOX_EMAIL wins; BUSINESS_EMAIL is the fallback)
CONTACT_INBOX_EMAIL=
BUSINESS_EMAIL=
# Default timezone for "today" when a company has none set (default UTC)
BUSINESS_TIMEZONE=
# Marketing analytics, loaded only after cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
# /demo page video (default: the bundled /videos/autoura-campaign.mp4)
NEXT_PUBLIC_DEMO_VIDEO_URL=
# A label in the sidebar to tell environments apart, e.g. STAGING
NEXT_PUBLIC_APP_LABEL=
# Proxy hops in front of the app, for reading the client IP (default 1)
TRUSTED_PROXY_COUNT=
# GTM Inbound Concierge widget (autoura-growth app on Railway). The marketing
# landing page shows a chat launcher iframing this URL. Unset = launcher hidden.
# e.g. https://growth.getautoura.net/widget
NEXT_PUBLIC_GROWTH_WIDGET_URL=
# Server-error alerts: a Slack/Discord (or any "POST {text}") incoming webhook.
# Each distinct error is posted at most once per 10 minutes. Unset = log only.
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------
# SCHEDULED JOBS — set on each cron service (see docs/CRON-JOBS.md)
# ------------------------------------------------------------
# The app URL the job calls. CRON_TARGET_URL can point at Railway's private
# network; both fall back to NEXT_PUBLIC_APP_URL.
CRON_TARGET_URL=
APP_URL=

# ------------------------------------------------------------
# SET BY THE PLATFORM — normally leave alone
# ------------------------------------------------------------
# The deployed commit, shown by /api/version and the health checks. Railway
# provides RAILWAY_GIT_COMMIT_SHA, which is used when this is unset.
GIT_SHA=

# ------------------------------------------------------------
# TESTS AND SMOKE SCRIPTS ONLY — not used by the running app
# ------------------------------------------------------------
# E2E_SUPABASE_URL=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_USER_PASSWORD=
# E2E_ALLOW_SHARED_PROJECT=
# BASE_URL=          (scripts/smoke-pricing-grid.mjs)
# GRID_COOKIE=
# SMOKE_WRITE=
# TIER=
